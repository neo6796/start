# Nasadenie cez docker-compose – skopíruj tento súbor ako `.env`.
#
#   cp .env.example .env
#   # uprav hodnoty
#   docker compose up -d --build

# --- Doména a HTTPS ---
# Skutočná doména → Caddy automaticky vybaví HTTPS certifikát (Let's Encrypt).
# Na lokálne vyskúšanie nechaj ":80" (bez HTTPS).
SITE_ADDRESS=mlieko.ahafarma.sk
# Verejná adresa appky (odkaz v pripomienke). Pri HTTPS použi https://…
PUBLIC_URL=https://mlieko.ahafarma.sk

# --- Uzávierka objednávok ---
TZ_NAME=Europe/Bratislava
DEADLINE_DAY=4          # 1=Po … 7=Ne (4 = štvrtok)
DEADLINE_TIME=12:00
REMINDER_OFFSET_DAYS=1  # pripomienka deň vopred
REMINDER_TIME=12:00
ENFORCE_DEADLINE=true

# --- Doručenie a spracovanie po uzávierke ---
DELIVERY_DAY=5          # predvolený deň doručenia (5 = piatok), dá sa zmeniť pri potvrdení
ADMIN_PIN=              # PIN pre záložku Spracovanie (prázdne = bez ochrany)
COURIER_TOKEN=          # token pre kuriérsky odkaz /kurier?t=<token> (prázdne = vypnuté)

# --- WhatsApp (Twilio) ---
# Bez týchto hodnôt appka beží v DEV režime (správy sa iba logujú).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_TO=
