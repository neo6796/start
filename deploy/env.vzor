# Skopírovať na serveri ako .env a vyplniť. Do gitu nikdy nejde.
DB_HESLO=
SMTP_HOST=mail.pdvrable.sk
SMTP_PORT=587
SMTP_MENO=obedy
SMTP_HESLO=
SMTP_OD=obedy@ahafarma.sk
SMTP_EHLO=obedy.ahafarma.sk
ADRESA=https://obedy.ahafarma.sk
# Kópia objednávky pre správcu, aby o nej vedel aj človek, nielen databáza.
# Keď sa rovná adrese jedálne (počas ladenia), kópia sa neposiela.
KOPIA=

# Testovacia kópia (./test-kopia.sh). Kým je prázdna, kópia beží len na slučke
# a chodí sa na ňu tunelom cez SSH. Vyplní sa až vtedy, keď na tú adresu
# ukazuje DNS — Caddy si potom certifikát vybaví sám.
TEST_DOMENA=
ADRESA_TEST=http://localhost:8080
