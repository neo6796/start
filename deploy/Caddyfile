# Obedár. Caddy si certifikát od Let's Encrypt vybaví aj obnovuje sám.
#
# Na tej istej adrese bežia dve veci:
#   /          — appka (krok 1 a 2 druhej etapy)
#   /preview/  — klikací prototyp, ktorý ukazuje celý cieľový stav
#
# Preview zámerne neostalo na koreni: appka je to, čo majú ľudia otvárať.
#
# Odkedy appka beží, hodnota prototypu je už len v obrazovkách, ktoré ešte
# nie sú naprogramované — ceny, mzdový podklad, mesačná uzávierka, tlačové
# zostavy. Tie štyri, ktoré appka má (prihlásenie, Môj tím, Môj týždeň,
# Ľudia), sú v ňom už neaktuálne a mýlia. Preto má hore vetu, že je to
# prototyp. Po kroku 6 z neho ostane taký zvyšok, že sa zmaže celý.

obedy.ahafarma.sk {
	encode gzip

	# Interná appka firmy, nie stránka pre verejnosť.
	header X-Robots-Tag "noindex, nofollow"

	redir /preview /preview/
	handle_path /preview/* {
		root * /srv
		file_server
		# Prototyp sa mení často — nech prehliadač neukazuje starú verziu.
		header Cache-Control "no-cache"
	}

	handle {
		reverse_proxy app:3000
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Testovacia kópia. Kým `TEST_DOMENA` v .env nie je vyplnená, tento blok počúva
# na slučke na porte, ktorý zvonku nikto nevidí — Caddy si teda ani nepýta
# certifikát pre doménu, ktorá ešte neexistuje. Keď na test.obedy.ahafarma.sk
# začne ukazovať DNS, stačí ju do .env doplniť a Caddy zvyšok vybaví sám.
#
# Náhradu za prázdnu hodnotu dosádza docker-compose, nie zápis `{$...:...}`
# nižšie: ten platí len na **nenastavenú** premennú. Prázdna je pre Caddy
# nastavená, dosadí prázdno a ostane mu blok bez adresy — a taký súbor odmietne
# celý, aj s ostrou stránkou. Zápis nižšie tu ostáva pre prípad, že by Caddy
# niekto pustil mimo compose.
{$TEST_DOMENA:http://127.0.0.1:9999} {
	encode gzip
	header X-Robots-Tag "noindex, nofollow"

	# Aby sa test nikdy nepomýlil s ostrou prevádzkou — ani na obrázku
	# v hovore, ani v hlave. Pruh je vidieť na každej obrazovke.
	header X-Obedar-Kopia "test"
	handle {
		reverse_proxy app-test:3000
	}
}
