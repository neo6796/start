# Obedár. Caddy si certifikát od Let's Encrypt vybaví aj obnovuje sám.
#
# Na tej istej adrese bežia dve veci:
#   /          — appka (krok 1 a 2 druhej etapy)
#   /preview/  — klikací prototyp, ktorý ukazuje celý cieľový stav
#
# Preview zámerne neostalo na koreni: appka je to, čo majú ľudia otvárať.
# Prototyp sa ďalej hodí na ukazovanie predákom a mzdárke, preto sa nemaže.

obedy.ahafarma.sk {
	encode gzip

	# Interná appka firmy, nie stránka pre verejnosť.
	header X-Robots-Tag "noindex, nofollow"

	redir /preview /preview/
	handle_path /preview/* {
		root * /srv
		file_server
		# Prototyp sa mení často — nech prehliadač neukazuje starú verziu.
		header Cache-Control "no-cache"
	}

	handle {
		reverse_proxy app:3000
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
