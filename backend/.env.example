# Skopíruj tento súbor ako `.env` a doplň hodnoty z Twilio konzoly.
# Bez týchto premenných appka beží v DEV režime – WhatsApp správy sa iba
# vypíšu do konzoly, nič sa reálne neodošle.

# Port backendu (voliteľné)
PORT=3001

# --- Twilio WhatsApp ---
# SID a token nájdeš na https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Odosielacie WhatsApp číslo z Twilia.
# Na testovanie použi Twilio Sandbox číslo, napr.:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Voliteľné: číslo nákupcu, ktorému príde upozornenie o každej novej objednávke.
ADMIN_WHATSAPP_TO=

# --- Uzávierka objednávok a pripomienky ---
# Deň uzávierky: 1=pondelok … 7=nedeľa (predvolené 4 = štvrtok)
DEADLINE_DAY=4
# Čas uzávierky (HH:MM, v nastavenej časovej zóne)
DEADLINE_TIME=12:00
# Pripomienka sa posiela o toľko dní pred uzávierkou (predvolené 1 = deň vopred)
REMINDER_OFFSET_DAYS=1
# Čas odoslania pripomienky (HH:MM)
REMINDER_TIME=12:00
# Vynucovať uzávierku? true = po deadline-e sa nedá objednať (predvolené true)
ENFORCE_DEADLINE=true
# Časová zóna pre výpočty (predvolené Europe/Bratislava)
TZ_NAME=Europe/Bratislava
# Verejná adresa appky – pridá sa ako odkaz do pripomienky (voliteľné)
PUBLIC_URL=https://mlieko.ahafarma.sk
