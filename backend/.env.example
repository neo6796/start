# Skopíruj tento súbor ako `.env` a doplň hodnoty z Twilio konzoly.
# Bez týchto premenných appka beží v DEV režime – WhatsApp správy sa iba
# vypíšu do konzoly, nič sa reálne neodošle.

# Port backendu (voliteľné)
PORT=3001

# --- Twilio WhatsApp ---
# SID a token nájdeš na https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Odosielacie WhatsApp číslo z Twilia.
# Na testovanie použi Twilio Sandbox číslo, napr.:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Voliteľné: číslo nákupcu, ktorému príde upozornenie o každej novej objednávke.
ADMIN_WHATSAPP_TO=
