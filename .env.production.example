# Copy to .env.production and fill in real values before docker compose up.

# SQLite DB inside the container volume - usually leave as-is.
DATABASE_URL=file:/data/dev.db

# REQUIRED: a long random string. Generate with: openssl rand -base64 32
AUTH_SECRET=

# REQUIRED: public URL of the deployment (HTTPS in production for Web Push).
AUTH_URL=https://obedy.firma.sk

# SMTP for magic-link login.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=obedy@firma.sk

# Comma-separated emails that become admin on first login.
ADMIN_EMAILS=admin@firma.sk

# VAPID keys for Web Push (generate with: pnpm vapid:generate locally, paste here).
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@firma.sk

# Shared secret for cron endpoints (/api/scrape, /api/push/remind).
CRON_SECRET=

SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; ObedyBot/1.0)
